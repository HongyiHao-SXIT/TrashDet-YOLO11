# Copy to backend/.env and fill in. Real environment variables take precedence over this file,
# and this file takes precedence over runtime_config.yaml.

# --- Security (required in any shared deployment) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Bootstrap admin, created only when the database has no users yet
TRASHDET_ADMIN_USERNAME=admin
TRASHDET_ADMIN_PASSWORD=
TRASHDET_ADMIN_SECURITY_CODE=

# --- Database: either a full URL ... ---
# DATABASE_URL=sqlite:///trashdet.db
# ... or MySQL parts (leave all empty to use SQLite at backend/trashdet.db)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=

# --- Detection ---
# YOLO_MODEL_PATH=model/runs/train/train-200epoch-v11n.pt-bs16/weights/best.pt
YOLO_CONF_THRESHOLD=0.25
DETECT_LEFT_HALF_ONLY=false
CAMERA_TIMEOUT_MS=3000

# --- Misc ---
CAPTCHA_ENABLED=true
TRAIN_MAX_CONTENT_LENGTH=1073741824
FLASK_DEBUG=false
